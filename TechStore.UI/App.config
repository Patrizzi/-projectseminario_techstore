<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Cadena de conexión activa para LocalDB en este equipo -->
        <add name="cn_techstore" connectionString="Data Source=(localdb)\MSSQLLocalDB; Initial Catalog=bd_techstore; Integrated Security=true;" providerName="System.Data.SqlClient" />
        <!-- Opción alternativa con SQL Server Express o instancia local: -->
        <!-- <add name="cn_techstore" connectionString="Data Source=.; Initial Catalog=bd_techstore; Integrated Security=true;" providerName="System.Data.SqlClient" /> -->
    </connectionStrings>
</configuration>

